{
  "cleanUrls": true,
  "outputDirectory": ".",
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/api-docs", "dest": "/api-docs.html" },
    { "src": "/(.*\\.html)", "dest": "/$1" }
  ]
}
